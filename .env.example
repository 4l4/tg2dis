# Токен Telegram-бота от @BotFather. Бота нужно сделать АДМИНОМ канала-источника.
TG_BOT_TOKEN=123456:ABC-your-telegram-bot-token

# (необязательно) фильтр по каналу-источнику: id (-100...) или @username.
# Если бот сидит только в одном канале — можно оставить пустым.
TG_SOURCE_CHAT_ID=

# Токен Discord-бота (Developer Portal -> ваше приложение -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=your-discord-bot-token

# ID текстового канала Discord, куда постить
# (Настройки Discord -> Расширенные -> Режим разработчика; ПКМ по каналу -> Copy Channel ID)
DISCORD_CHANNEL_ID=123456789012345678

# (необязательно) канал для анонсов стримов (пост со ссылкой на kick.com / w.tv / goodgame.ru).
# Такие посты уходят туда с пингом @everyone. Пусто -> 1550093981113778206.
DISCORD_ANNOUNCE_CHANNEL_ID=

# Порог размера файла (МБ). Больше 20 Bot API всё равно не скачает -> будет ссылка на пост.
MAX_FILE_MB=20

# Длительность опроса в Discord (часы), по умолчанию 24.
POLL_HOURS=24
